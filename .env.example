# Facebook Automation Configuration

# Directorio donde se guardará la sesión/perfil persistente de Chrome
FB_USER_DATA_DIR=fb_user_data

# Archivo con la lista de URLs de los grupos (uno por línea)
FB_GROUPS_FILE=groups.txt

# Carpeta que contiene 'post_content.txt' y todos los archivos de imagen/video para la publicación
FB_POST_DIR=post_data

# Archivo JSON donde se guarda el historial de publicaciones (para reanudación automática)
FB_HISTORY_FILE=post_history.json

# Tamaño de cada tanda (por ejemplo, tandas de 10 grupos)
FB_BATCH_SIZE=10

# Tiempo mínimo y máximo de espera aleatoria entre cada post en la misma tanda (en segundos)
FB_MIN_POST_DELAY=45
FB_MAX_POST_DELAY=90

# Tiempo de enfriamiento/cooldown entre tanda y tanda (en segundos: 30 segundos)
FB_BATCH_COOLDOWN=30

# Ejecutar en segundo plano sin ventana (false recomendado para evitar detección por bots)
FB_HEADLESS=false

# Simular tipeo humano con pausas aleatorias entre teclas
FB_HUMAN_TYPING=true

# Dimensiones de la ventana del navegador
FB_VIEWPORT_WIDTH=1280
FB_VIEWPORT_HEIGHT=850
